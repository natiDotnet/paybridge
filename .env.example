# PayBridge configuration (all values have working dev defaults)
PAYBRIDGE_BIND=0.0.0.0:4000
DATABASE_URL=postgresql://neondb_owner:password@ep-fragrant-band-axj0pjgv-pooler.c-4.us-east-2.aws.neon.tech/paygate?sslmode=require&channel_binding=require
# DATABASE_URL=sqlite://paybridge.db?mode=rwc
# Public base URL used to build paymentUrl for merchants
PAYBRIDGE_BASE_URL=http://localhost:4000

# mock = in-process verifier for dev/tests; http = the real verification service
VERIFIER=http
VERIFY_SERVICE_URL=https://verify-sisl.onrender.com
VERIFY_SERVICE_API_KEY=

CHECKOUT_TTL_DEFAULT=24h
CHECKOUT_TTL_MAX=7d
VERIFY_MAX_ATTEMPTS_PER_CHECKOUT=10
VERIFY_ATTEMPT_COOLDOWN=5s
WEBHOOK_RETRY_SCHEDULE=0s,30s,2m,10m,45m,2h,6h,24h
WORKER_POLL_INTERVAL=5s

RUST_LOG=info,paybridge=debug

# Admin portal (http://localhost:4000/admin) — single shared admin password.
# The dev default is only for local use; always set this in staging/prod.
PAYBRIDGE_ADMIN_PASSWORD=paybridge-admin

# Admin portal login (bootstrapped superadmin user). Merchants self-register
# at /signup and land in pending status until approved.
PAYBRIDGE_ADMIN_EMAIL=admin@paybridge.local
PAYBRIDGE_ADMIN_PASSWORD=paybridge-admin
